#ddev-generated
ARG STATIC_PHP_EXTENSIONS
ARG STATIC_PHP_VERSION

RUN (apt-get update || true) && DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::="--force-confnew" --no-install-recommends --no-install-suggests build-essential

RUN --mount=type=secret,id=github_token <<EOF
set -eu -o pipefail

# Optional token to avoid GitHub API rate limiting in static-php-cli downloads
if [ -s /run/secrets/github_token ]; then
  GITHUB_TOKEN="$(cat /run/secrets/github_token)"
  export GITHUB_TOKEN
fi

# static-php-cli requires at least PHP 8.4 to build
update-alternatives --set php /usr/bin/php8.4
if update-alternatives --display php-fpm >/dev/null 2>&1; then update-alternatives --set php-fpm /usr/sbin/php-fpm8.4; else ln -sf /usr/sbin/php-fpm8.4 /usr/sbin/php-fpm; fi

mkdir -p /usr/local/src/static-php-cli && cd /usr/local/src/static-php-cli
# Resolve the latest tag from the release redirect to avoid the GitHub API rate limit
LATEST_RELEASE_URL="$(curl -fsSIL --retry 3 -o /dev/null -w '%{url_effective}' "https://github.com/crazywhalecc/static-php-cli/releases/latest")"
LATEST_RELEASE_TAG="${LATEST_RELEASE_URL##*/}"
if [[ ! "${LATEST_RELEASE_TAG}" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Unable to determine the latest static-php-cli release from '${LATEST_RELEASE_URL}'" >&2
  exit 1
fi
git clone --branch "${LATEST_RELEASE_TAG}" --depth 1 https://github.com/crazywhalecc/static-php-cli.git .
composer update -n
chmod +x bin/spc
bin/spc doctor --auto-fix
rm -rf source/* buildroot/*

# Retry because GitHub API release lookups fail intermittently; already-downloaded sources are skipped
for attempt in 1 2 3; do
  if bin/spc download --prefer-pre-built --for-extensions="${STATIC_PHP_EXTENSIONS}" -U "php-src:https://www.php.net/distributions/php-${STATIC_PHP_VERSION}.tar.gz"; then
    break
  fi
  if [ "${attempt}" -eq 3 ]; then
    echo "bin/spc download failed after ${attempt} attempts" >&2
    exit 1
  fi
  echo "bin/spc download failed (attempt ${attempt}), retrying in $((attempt * 15))s" >&2
  sleep $((attempt * 15))
done

# opcache would normally be here but build fails: https://github.com/crazywhalecc/static-php-cli/issues/192
if [[ ${STATIC_PHP_VERSION} =~ ^[89] ]]; then export STATIC_PHP_EXTENSIONS="${STATIC_PHP_EXTENSIONS},opcache"; fi

# Scan our own conf.d and the project's .ddev/php directory for additional ini files
bin/spc build "${STATIC_PHP_EXTENSIONS}" --build-cli --build-fpm --with-config-file-scan-dir=/usr/local/etc/php/conf.d:/mnt/ddev_config/php

chown -R "${uid}:${gid}" /usr/local/src/static-php-cli
EOF

# Set up symlinks to make the new PHP version the default php and php-fpm
RUN ln -sf /usr/local/src/static-php-cli/buildroot/bin/php /usr/bin/php${DDEV_PHP_VERSION} && \
    ln -sf /usr/local/src/static-php-cli/buildroot/bin/php-fpm /usr/sbin/php-fpm${DDEV_PHP_VERSION} && \
    ln -sf /etc/php/${DDEV_PHP_VERSION}/fpm/php-fpm.conf /etc/php-fpm.conf

# Use DDEV's php.ini for each SAPI; static PHP reads php-<sapi>.ini from its config path before php.ini.
# DDEV's conf.d files can't be used because static PHP can't load shared extensions,
# so carry over the one setting they add
RUN mkdir -p /usr/local/etc/php/conf.d && \
    ln -sf /etc/php/${DDEV_PHP_VERSION}/cli/php.ini /usr/local/etc/php/php-cli.ini && \
    ln -sf /etc/php/${DDEV_PHP_VERSION}/fpm/php.ini /usr/local/etc/php/php-fpm-fcgi.ini && \
    printf 'zend.assertions = 1\n' > /usr/local/etc/php/conf.d/20-assert.ini
